# DubaiExpat — environment variables
#
# This file lists EVERY variable the code actually reads, and nothing else.
# Derived from `grep -r process.env app/ components/ lib/ scripts/` on
# 2026-08-06. Placeholder values only — never commit a real key here.
#
# Production values live in the Vercel project `dubai-expat`
# (Settings → Environment Variables), bound to Preview + Production.
# Copy this file to `.env.local` for local development.

# Brevo master API key. Read by app/api/subscribe/route.ts and
# app/api/contact/route.ts.
# Without it: POST /api/subscribe returns HTTP 500 with code CONFIG_ERROR and
# the signup form shows an error — no contact stored, no magnet sent. The
# contact form likewise returns 500 and the message is never delivered.
BREVO_API_KEY=

# Numeric ID of the Brevo "DX pending" contact list. Read by
# app/api/subscribe/route.ts.
# Without it: identical failure to a missing API key — 500 / CONFIG_ERROR,
# because there is no list to add the subscriber to.
BREVO_DX_PENDING_LIST_ID=

# ── Not required ──────────────────────────────────────────────────────────
# This file previously documented BREVO_LIST_ID, BREVO_FROM_EMAIL,
# BREVO_FROM_NAME and NEXT_PUBLIC_GA_MEASUREMENT_ID. The code reads none of
# them: the sender identity is hard-coded in app/api/subscribe/magnets.ts and
# app/api/contact/route.ts, and GA4 (G-Q93X7TD1X2) is hard-coded in the root
# layout. Anyone provisioning from the old list got a silently-broken
# subscribe route. (Plumbing audit 2026-08-06, finding A6.)
#
# BREVO_DX_GENERAL_LIST_ID exists in the Vercel project but is referenced
# nowhere in this codebase (finding A4). Do not add it here until something
# reads it.
