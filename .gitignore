# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build stamp — generated by scripts/write-build-info.mjs at build time,
# served at /build-info.json, read by infrastructure/scripts/check_deploys.py.
# Generated, never committed: a committed copy would go stale and lie.
public/build-info.json

# FUSE mount artefacts — deleted-but-open files the sandbox leaves behind.
# Three of these were committed on 17 Sep 2026 as stale duplicates of live
# articles. They do not match the *.mdx globs so the site ignored them, but they
# corrupt every grep-based content and affiliate-link audit.
.fuse_hidden*
